{
  "name": "codex-pet-pause",
  "private": true,
  "version": "0.2.1",
  "description": "A playful, local-first break reminder PWA with interactive and Codex-compatible pets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ccofallen/codex-pet-pause.git"
  },
  "homepage": "https://ccofallen.github.io/codex-pet-pause/",
  "author": {
    "name": "ccofallen",
    "email": "ccofallen@users.noreply.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "build:e2e": "vite build --mode e2e --outDir .e2e-dist",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir .e2e-dist",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:electron": "vitest run --config vitest.electron.config.js",
    "test:mac-signing": "node --test scripts/after-pack.test.mjs",
    "test:e2e": "playwright test",
    "check:release-dist": "node scripts/verify-release-dist.mjs",
    "test:verify-release-dist": "node scripts/test-verify-release-dist.mjs",
    "verify:deployment": "node scripts/verify-deployment-build.mjs /",
    "verify:deployment:pages": "node scripts/verify-deployment-build.mjs /codex-pet-pause/",
    "verify:docs": "node scripts/verify-documentation.mjs",
    "test:verify-docs": "node scripts/test-verify-documentation.mjs",
    "test:verify-deployment-build": "node scripts/test-verify-deployment-build.mjs",
    "check": "npm run typecheck && npm run test:run && npm run build && npm run check:release-dist && npm run test:e2e && npm run check:release-dist",
    "desktop:smoke": "bash scripts/desktop-smoke.sh",
    "desktop:smoke:packaged-resources": "node scripts/verify-packaged-resources.mjs dist",
    "desktop:smoke:packaged-app": "node scripts/verify-packaged-app.mjs release",
    "desktop:dev": "npm run desktop:launch:dev",
    "desktop:build": "tsc -b && vite build --mode desktop",
    "start": "npm run build && ./node_modules/.bin/electron .",
    "start:direct": "npm run build && ./node_modules/.bin/electron . --no-sandbox",
    "desktop:dev:server": "vite --host 127.0.0.1",
    "desktop:launch": "npm run desktop:build && ./node_modules/.bin/electron . --no-sandbox",
    "desktop:launch:dev": "concurrently -k \"npm run desktop:dev:server\" \"wait-on tcp:5173 && ./node_modules/.bin/electron . --dev\"",
    "desktop:package": "npm run desktop:pack",
    "desktop:pack": "npm run desktop:build && electron-builder --publish=never",
    "desktop:pack:mac": "npm run desktop:pack -- --mac --arm64 --x64",
    "desktop:pack:win": "npm run desktop:pack -- --win",
    "desktop:pack:linux": "npm run desktop:pack -- --linux",
    "test:desktop-release-config": "node --test scripts/verify-desktop-release-config.test.mjs",
    "check:desktop-release-config": "node scripts/verify-desktop-release-config.mjs",
    "test:desktop-workflow": "node --test scripts/verify-desktop-workflow.test.mjs",
    "check:desktop-workflow": "node scripts/verify-desktop-workflow.mjs",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "test:brand-assets": "npm run brand:generate && node --test scripts/generate-brand-assets.test.mjs",
    "test:release-artifacts": "node --test scripts/verify-release-artifacts.test.mjs",
    "test:release-tag": "node --test scripts/verify-release-tag.test.mjs",
    "test:packaged-resources": "node --test scripts/verify-packaged-resources.test.mjs",
    "test:packaged-app": "node --test scripts/verify-packaged-app.test.mjs",
    "check:desktop-release": "npm run test:desktop-release-config && npm run test:brand-assets && npm run test:desktop-workflow && npm run test:electron && npm run test:mac-signing && npm run test:release-artifacts && npm run test:release-tag && npm run test:packaged-resources && npm run test:packaged-app && npm run check:desktop-release-config && npm run check:desktop-workflow && npm run typecheck && npm run test:run && npm run build && npm run test:e2e && npm run desktop:build && npm run desktop:smoke:packaged-resources"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.34",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electron/asar": "^3.4.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.4",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^27.0.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5",
    "yaml": "^2.8.1"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "io.elevenlabs.codexpetpause",
    "productName": "Codex Pet Pause",
    "asar": true,
    "afterPack": "scripts/after-pack.mjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build/icons",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "artifactName": "Codex-Pet-Pause-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Codex-Pet-Pause-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons/png",
      "maintainer": "ccofallen <ccofallen@users.noreply.github.com>",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Codex-Pet-Pause-${version}-linux-x64.${ext}"
    }
  }
}
